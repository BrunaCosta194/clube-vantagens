# Supabase — projeto NOVO, exclusivo do Clube de Vantagens (fase 2)
# O Sanchez Connect vai LER as tabelas membros/indicacoes depois, cruzando por CPF/CNPJ.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Bloco 10 — sobrescreve o Feed ID do Behold que está em InstagramFeed.tsx (opcional).
VITE_BEHOLD_FEED_ID=

# Anti-robô da cotação (Cloudflare Turnstile, widget "Site Sanchez", o mesmo do site da Sanchez).
# Chave pública (vai no HTML). Sem ela o widget não aparece e a função cotacao-enviar recusa o envio.
VITE_TURNSTILE_SITE_KEY=
